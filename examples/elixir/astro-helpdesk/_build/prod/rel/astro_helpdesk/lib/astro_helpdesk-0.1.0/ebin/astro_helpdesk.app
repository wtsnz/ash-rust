{application,astro_helpdesk,
    [{modules,
         ['Elixir.AstroHelpdesk.Application','Elixir.AstroHelpdesk.Desk',
          'Elixir.AstroHelpdesk.Desk.Representative',
          'Elixir.AstroHelpdesk.Desk.Representative.RepresentativeCreated.Config',
          'Elixir.AstroHelpdesk.Desk.Representative.RepresentativeDestroyed.Config',
          'Elixir.AstroHelpdesk.Desk.Representative.RepresentativeUpdated.Config',
          'Elixir.AstroHelpdesk.Desk.Ticket',
          'Elixir.AstroHelpdesk.Desk.Ticket.TicketCreated.Config',
          'Elixir.AstroHelpdesk.Desk.Ticket.TicketDestroyed.Config',
          'Elixir.AstroHelpdesk.Desk.Ticket.TicketUpdated.Config',
          'Elixir.AstroHelpdesk.Schema',
          'Elixir.AstroHelpdesk.Schema.AstroHelpdesk.Desk.AshTypes',
          'Elixir.AstroHelpdesk.Schema.Compiled','Elixir.AstroHelpdesk.Seed',
          'Elixir.AstroHelpdesk.Types.Attachment',
          'Elixir.AstroHelpdesk.Types.Attachment.EctoType',
          'Elixir.AstroHelpdesk.Types.TicketStatus',
          'Elixir.AstroHelpdesk.Types.TicketStatus.EctoType',
          'Elixir.AstroHelpdeskWeb.Cors','Elixir.AstroHelpdeskWeb.Endpoint',
          'Elixir.AstroHelpdeskWeb.ErrorJSON',
          'Elixir.AstroHelpdeskWeb.GraphqlSocket',
          'Elixir.AstroHelpdeskWeb.Router',
          'Elixir.Inspect.AstroHelpdesk.Desk.Representative',
          'Elixir.Inspect.AstroHelpdesk.Desk.Ticket']},
     {compile_env,
         [{astro_helpdesk,
              ['Elixir.AstroHelpdeskWeb.Endpoint',code_reloader],
              error},
          {astro_helpdesk,
              ['Elixir.AstroHelpdeskWeb.Endpoint',debug_errors],
              error},
          {astro_helpdesk,
              ['Elixir.AstroHelpdeskWeb.Endpoint',force_ssl],
              error}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,ash,ash_graphql,absinthe,absinthe_plug,
          absinthe_graphql_ws,absinthe_phoenix,phoenix,phoenix_pubsub,bandit,
          jason,picosat_elixir]},
     {description,"astro_helpdesk"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.AstroHelpdesk.Application',[]}}]}.
